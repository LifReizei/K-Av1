{
  "id": "animeav1-revamp",
  "name": "AnimeAV1 Revamp",
  "version": "3.2.1",
  "apiVersion": 20,
  "author": "LifReizei (Revamp by Mumei)",
  "description": "Anime en español latino y subtitulado desde animeav1.com.",
  "langs": ["es"],
  "nsfw": false,
  "entry": "plugin.js",
  "color": "#8E6BFF",
  "section": { "label": "AnimeAV1 Revamp" },
  "categories": ["anime"],
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve"
  ],
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "*.voe.sx",
    "mp4upload.com",
    "*.mp4upload.com",
    "yourupload.com",
    "*.yourupload.com",
    "vidcache.net",
    "*.vidcache.net",
    "streamtape.com",
    "tapecontent.net",
    "*.tapecontent.net",
    "graphql.anilist.co"
  ],
  "settings": [
    {
      "key": "device_profile",
      "label": "Dispositivo",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto (Detección)" },
        { "value": "tv", "label": "TV / Box" },
        { "value": "mobile", "label": "Celular" },
        { "value": "pc", "label": "PC" },
        { "value": "custom", "label": "Manual" }
      ]
    },
    {
      "key": "audio",
      "label": "Audio / Subtítulos",
      "type": "select",
      "default": "sub",
      "options": [
        { "value": "sub", "label": "Solo subtitulado" },
        { "value": "dub", "label": "Solo doblado (latino)" },
        { "value": "dub-sub", "label": "Doblado, o sub si no hay" }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automático (recomendado)" },
        { "value": "voe", "label": "Voe · Rápido · TV 720p" },
        { "value": "upnshare", "label": "UPNShare · HD · TV 1080p" },
        { "value": "mp4upload", "label": "MP4Upload · Estable · Celular/TV" },
        { "value": "yourupload", "label": "YourUpload · Estándar 1" },
        { "value": "streamtape", "label": "StreamTape · Estándar 2" }
      ]
    }
  ],
  "profiles": {
    "tv": {
      "audio": "dub-sub",
      "servidor": "upnshare",
      "precache_limit_mb": 100,
      "force_hls": true
    },
    "mobile": {
      "audio": "sub",
      "servidor": "mp4upload",
      "precache_limit_mb": 20,
      "force_hls": false
    },
    "pc": {
      "audio": "sub",
      "servidor": "auto",
      "precache_limit_mb": 50,
      "force_hls": true
    }
  },
  "icon": "icon.png"
}