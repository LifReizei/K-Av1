  "description": "AnimeAV1 Ultimate: Soporte multi-servidor, organización por temporadas y resolución de enlaces optimizada.",
  "color": "#8E6BFF",
  "section": {
    "label": "AnimeAV1 Ultimate"
  },
  "categories": ["anime"],
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "*.mp4upload.com",
    "yourupload.com",
    "*.yourupload.com",
    "vidcache.net",
    "streamtape.com",
    "tapecontent.net",
    "*.tapecontent.net",
    "*.uns.bio"
  ],
  "streamHosts": "any",
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve"
