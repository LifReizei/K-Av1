        { "value": "upnshare", "label": "UPNShare (1080p - Alta compatibilidad TV)" },
        { "value": "mp4upload", "label": "MP4Upload (1080p AV1)" },
        { "value": "yourupload", "label": "YourUpload (MP4 - Estándar)" },
        { "value": "streamtape", "label": "StreamTape (MP4 - Estándar)" }
      ]
    }
  ],
  "icon": "icon.png"
}