{
  "id": "animeav1-ultimate",
  "name": "AnimeAV1 Ultimate",
  "version": "3.1.0",
  "apiVersion": 7,
  "entry": "plugin.js",
  "description": "Versión definitiva de AnimeAV1: Catálogo optimizado, manejo robusto de temporadas, lógica de resolución de alta compatibilidad y selección inteligente de servidores.",
  "color": "#8E6BFF",
  "section": {
    "label": "AnimeAV1 Ultimate"
  },
  "categories": ["anime"],
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "*.mp4upload.com",
    "yourupload.com",
    "*.yourupload.com",
    "vidcache.net",
    "streamtape.com",
    "tapecontent.net",
    "*.tapecontent.net",
    "*.uns.bio"
  ],
  "streamHosts": "any",
  "capabilities": ["home", "browse", "search", "episodes", "resolve", "download"],
  "settings": [
    {
      "key": "idioma",
      "label": "Preferencia de Idioma",
      "type": "select",
      "default": "dub-sub",
      "options": [
        { "value": "dub", "label": "Solo Latino" },
        { "value": "dub-sub", "label": "Latino (sub si no hay)" },
        { "value": "sub", "label": "Solo Subtitulado" }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor Predeterminado",
      "type": "select",
      "default": "voe",
      "options": [
        { "value": "voe", "label": "Voe (720p - Alta compatibilidad TV)" },
        { "value": "upnshare", "label": "UPNShare (1080p - Alta compatibilidad TV)" },
        { "value": "mp4upload", "label": "MP4Upload (1080p AV1 - Solo dispositivos compatibles)" },
        { "value": "yourupload", "label": "YourUpload (MP4 - Estándar)" },
        { "value": "streamtape", "label": "StreamTape (MP4 - Estándar)" }
      ]
    }
  ],
  "icon": "icon.png"
}