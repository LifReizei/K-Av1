{
  "id": "animeav1-improved",
  "name": "AnimeAV1 Improved",
  "version": "2.3.1",
  "apiVersion": 7,
  "author": "LifReizei",
  "description": "Anime en español latino y subtitulado — 5 servidores con fallback automático (Voe 720p HLS primero, luego UPNShare 1080p, luego MP4/AV1)",
  "langs": ["es"],
  "nsfw": false,
  "entry": "plugin.js",
  "color": "#000000",
  "section": {
    "label": "AnimeAV1 Improved"
  },
  "categories": ["anime"],
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "*.mp4upload.com",
    "yourupload.com",
    "*.yourupload.com",
    "vidcache.net",
    "*.vidcache.net",
    "streamtape.com",
    "tapecontent.net",
    "*.tapecontent.net",
    "*.uns.bio"
  ],
  "streamHosts": "any",
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve"
  ],
  "settings": [
    {
      "key": "idioma",
      "label": "Idioma",
      "type": "select",
      "default": "sub",
      "options": [
        { "value": "sub", "label": "Subtitulado" },
        { "value": "dub", "label": "Doblado" },
        { "value": "dub-sub", "label": "Doblado (si no hay, subtitulado)" }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automático (recomendado)" },
        { "value": "voe", "label": "TV 720p — Voe (H.264 HLS)" },
        { "value": "upnshare", "label": "TV 1080p — UPNShare (H.264 HLS)" },
        { "value": "yourupload", "label": "Estándar MP4 — YourUpload" },
        { "value": "streamtape", "label": "Estándar MP4 — StreamTape" },
        { "value": "mp4upload", "label": "HIFI AV1 — MP4Upload (no compatible con muchas TVs)" }
      ]
    }
  ],
  "icon": "icon.png"
}